  _npcId: NPC_GUIDE_01
  _npcName: "\uBC29\uB791 \uAE30\uC0AC"
  _dialogueLines:
  - "\uC774 \uC55E\uC740 \uBAAC\uC2A4\uD130\uB4E4\uC758 \uC11C\uC2DD\uC9C0\uB2E4. \uBD89\uC740 \uC2EC\uBCFC\uC5D0 \uB2FF\uC73C\uBA74 \uC989\uC2DC D20 \uC804\uD22C\uAC00 \uC2DC\uC791\uB418\uB2C8 \uC8FC\uC758\uD558\uAC8C!"
  - "\uBCF4\uBB3C\uC0C1\uC790\uC5D0\uC11C \uC5D8\uB9AD\uC11C\uB97C \uD68D\uB4DD\uD558\uACE0 \uCDA9\uBD84\uD788 \uCC44\uBE44\uB97C \uB9C8\uCE5C \uD6C4 \uC9C4\uC785\uD558\uB294 \uAC83\uC774 \uC88B\uC744 \uAC70\uC57C."
